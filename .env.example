# Conversa AI Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
AGENT_HOST=0.0.0.0
AGENT_PORT=8001

# LLM Provider Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# PostgreSQL Persistence Configuration
POSTGRES_DB=conversa
POSTGRES_USER=conversa_user
POSTGRES_PASSWORD=conversa_password
# Internal Docker Compose connection:
DATABASE_URL=postgresql+asyncpg://conversa_user:conversa_password@postgres:5432/conversa
# Local host connection (outside Docker):
# DATABASE_URL=postgresql+asyncpg://conversa_user:conversa_password@localhost:5432/conversa

# Apache Kafka Event Streaming Configuration
# Internal Docker Compose connection:
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Local host connection (outside Docker):
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ENABLE_KAFKA_DELIVERY=true

# Agent Orchestration & Trigger Settings
AGENT_AUTO_RUN=false
AGENT_TRIGGER_MIN_NEW_MESSAGES=3
AGENT_TRIGGER_DEBOUNCE_MS=3000
AGENT_SESSION_COOLDOWN_SECONDS=20
AGENT_MAX_CONCURRENT_RUNS_PER_SESSION=1
MOCK_LLM=true

# Conversational Turn-Completion Intelligence (Gate 1)
# Safe default: false (requires explicit operator enablement)
AGENT_TURN_COMPLETION_ENABLED=false
AGENT_TURN_PAUSE_QUESTION_MS=1500
AGENT_TURN_PAUSE_COMPLETE_MS=2500
AGENT_TURN_PAUSE_INCOMPLETE_MS=4500

# Audio Gateway & Real-Time Speech Configuration
AUDIO_GATEWAY_PORT=8002
DELIVERY_SERVICE_PORT=8003
TRANSCRIPTION_SERVICE_PORT=8004

WHISPER_MODEL_SIZE=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VAD_MOCK=false
WHISPER_MOCK=false
